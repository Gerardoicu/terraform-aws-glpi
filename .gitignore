# ==== TERRAFORM ====
# Local provider and plugin cache
.terraform/
.terraform.lock.hcl

# State and backup files
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*.backup
*.bak

# Sensitive variable files (never commit)
terraform.tfvars
terraform.tfvars.json
*.tfvars
*.tfvars.json

# Environment-specific configs
live/**/main.tfvars

# ==== AWS / CREDENTIALS ====
*.pem
*.key
*.crt
*.cer
*.pfx

# ==== USER DATA / SCRIPTS ====
user_data/*.sh
!user_data/helloworld.sh.example
!user_data/glpi.sh.example

# ==== IDE / SYSTEM FILES ====
.idea/
.vscode/
*.iml
*.log
.DS_Store
Thumbs.db

# ==== WINDOWS ====
ehthumbs.db
desktop.ini
