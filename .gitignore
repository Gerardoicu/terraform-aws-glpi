# ==== TERRAFORM ====
.terraform/
.terraform.lock.hcl

# State and backup files
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*.backup
*.bak

# Sensitive variable files (NEVER commit)
terraform.tfvars
terraform.tfvars.json
*.tfvars
*.tfvars.json

# Environment-specific configs (ignored per-env)
live/**/main.tfvars

# ==== AWS / SSH KEYS ====
*.pem
*.key
*.crt
*.cer
*.pfx

# ==== USER DATA / SCRIPTS ====
# SE PERMITE versionar scripts, excepto uno opcional con secretos
# (tu glpi.sh sí se debe versionar)
user_data/*secret*.sh

# ==== LOGS (solo los peligrosos) ====
# No ignores todos los .log globalmente
# Solo los que pertenezcan al runtime de EC2/container
*.runtime.log
*.install.log

# ==== IDE / EDITORS ====
.idea/
.vscode/
*.iml

# ==== OS FILES ====
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
